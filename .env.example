# Required: generate with `npm run hash-password -- "your-long-password"`
OWNER_USERNAME=Admin
OWNER_PASSWORD_HASH=scrypt$16384$8$1$replace-with-salt$replace-with-128-character-hex-hash
# Required: use at least 32 random characters
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters
# Set true when serving directly over HTTPS; production enables it automatically.
COOKIE_SECURE=false
# Optional persistent mount for orders and PDF files.
DATA_DIR=./data
PORT=3000
HOST=0.0.0.0
